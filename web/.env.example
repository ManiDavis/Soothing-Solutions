# Copy this file to .env.local and fill in your values
VITE_SANITY_READ_TOKEN=your_sanity_read_token_here

# --- Server-only vars for the /api/enquiry function (set these in the ---
# --- Vercel project settings, NOT with a VITE_ prefix — they must     ---
# --- never be bundled into client-side JS).                          ---
# Sanity API token with "Editor" (write) access, used to save trial-booking
# / contact form submissions as `enquiry` documents in the Studio.
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here
# Resend API key, used to email the team + auto-reply to the customer.
RESEND_API_KEY=your_resend_api_key_here
# Optional overrides:
# NOTIFY_EMAIL=info@thetrainstation.co.gg
# NOTIFY_FROM_EMAIL="TrainStation Website <notify@yourverifieddomain.com>"
